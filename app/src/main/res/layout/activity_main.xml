<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zamówienie pizzy"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wybierz pizzę" />

        <Spinner
            android:id="@+id/spPizza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wybierz rozmiar" />

        <Spinner
            android:id="@+id/spSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dodatki"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <CheckBox
            android:id="@+id/cbCheese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dodatkowy ser (+4 zł)" />

        <CheckBox
            android:id="@+id/cbHam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Szynka (+5 zł)" />

        <CheckBox
            android:id="@+id/cbMushrooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pieczarki (+3 zł)" />

        <CheckBox
            android:id="@+id/cbExpress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dostawa ekspresowa (+8 zł)" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adres dostawy"
            android:inputType="textPostalAddress" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dalej" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O aplikacji" />

    </LinearLayout>
</ScrollView>
